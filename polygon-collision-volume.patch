+	int crossings = 0;
+
+	for (size_t i = 0; i + 2 < indcs.size(); i += 3) {
+		const uint32_t ia = indcs[i + 0];
+		const uint32_t ib = indcs[i + 1];
+		const uint32_t ic = indcs[i + 2];
