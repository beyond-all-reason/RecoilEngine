+		return false;
+
+	const float invDet = 1.0f / det;
+	const float3 tv = org - v0;
+
+	const float u = tv.dot(pv) * invDet;
+	if (u < 0.0f || u > 1.0f)
+		return false;
+
+	const float3 qv = tv.cross(e1);
+	const float w = dir.dot(qv) * invDet;
+	if (w < 0.0f || (u + w) > 1.0f)
+		return false;
+
+	t = e2.dot(qv) * invDet;
+	return true;
