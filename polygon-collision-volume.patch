+				const float3 b = m * verts[ib].pos;
+				const float3 c = m * verts[ic].pos;
+
+				rb.AddVertex({a, sc}); rb.AddVertex({b, sc});
+				rb.AddVertex({b, sc}); rb.AddVertex({c, sc});
+				rb.AddVertex({c, sc}); rb.AddVertex({a, sc});
+			}
